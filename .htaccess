<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /1/

    # Prevent directory listing
    Options -Indexes

    # Block access to sensitive directories and files
    RewriteRule ^(\.git|\.env|database|bootstrap|storage|app|resources|routes)(/.*)?$ - [F,L,NC]
    RewriteRule \.(sqlite|env|pem|sh|bat|md|json|yml|yaml|log)$ - [F,L,NC]

    # Directly serve static assets from public/assets and public/data if present
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^data/(.*)$ public/data/$1 [L]

    # Send all other requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
